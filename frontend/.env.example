# SHERE MUSIC — frontend environment (all values are PUBLIC; never put secrets here).

# Base URL of the backend API including /api.
# Leave as /api in development (Vite proxies it to the backend) or when the API is
# served from the same domain. In production with a separate API host, e.g.:
#   VITE_API_URL=https://api.sheremusic.com/api
VITE_API_URL=/api

# Public URL of this site, used for canonical links and Open Graph tags.
VITE_SITE_URL=http://localhost:5173

# Google / Facebook sign-in (optional). Use the SAME project URL and the public
# anon key from Supabase → Settings → API. The anon key is safe to expose: the
# database grants it nothing. Leave both empty to hide the social sign-in buttons.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Development only: where Vite proxies /api requests.
DEV_API_PROXY=http://localhost:5000
