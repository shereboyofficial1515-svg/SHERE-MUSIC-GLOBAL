# SHERE MUSIC — frontend environment (all values are PUBLIC; never put secrets here).

# Where the backend API lives. "/api" is appended automatically if missing.
#   Development:            /api   (Vite proxies it to DEV_API_PROXY)
#   Production on Render:   https://api.your-domain.com   or   https://shere-music-api.onrender.com
#   Production via Vercel rewrite (same-origin, see README → Deployment): /api
# A Vercel build fails if this (or VITE_SITE_URL) points to localhost.
VITE_API_URL=/api

# Public URL of this site, used for canonical links and Open Graph tags.
# Production: https://www.your-domain.com (or your *.vercel.app URL)
VITE_SITE_URL=http://localhost:5173

# Google / Facebook sign-in (optional). Use the SAME project URL and the public
# anon key from Supabase → Settings → API. The anon key is safe to expose: the
# database grants it nothing. Leave both empty to hide the social sign-in buttons.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Paystack: no public key is needed — checkout redirects to Paystack's hosted page,
# and the secret key lives only on the backend.

# Development only: where Vite proxies /api requests.
DEV_API_PROXY=http://localhost:5000
