# SHERE MUSIC uses one env file per app:
#   backend/.env.example  → server secrets (Supabase service role, JWT, Resend)
#   frontend/.env.example → public build-time values (API URL, site URL)
# Copy each to .env in its folder. Never commit real .env files.

# Backend essentials (see backend/.env.example for every option)
PORT=
NODE_ENV=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

JWT_SECRET=

RESEND_API_KEY=
RESEND_FROM_EMAIL=

FRONTEND_URL=
