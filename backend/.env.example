# ─────────────────────────────────────────────────────────────
# SHERE MUSIC — backend environment
# Copy to .env and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

PORT=5000
NODE_ENV=development

# Supabase project (Project Settings → API)
SUPABASE_URL=
# Not used by the backend today; kept for tooling that needs it. Safe to leave empty.
SUPABASE_ANON_KEY=
# Server-only secret. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Storage buckets (created by `npm run setup:storage`)
# Private bucket for audio files (served through short-lived signed URLs)
STORAGE_AUDIO_BUCKET=music
# Public bucket for artwork, artist images, album covers, avatars and branding
STORAGE_MEDIA_BUCKET=media
# Private bucket for music videos (streamed through signed URLs, uploaded directly from the browser)
STORAGE_VIDEO_BUCKET=videos
# Private bucket for WebVTT subtitle files
STORAGE_SUBTITLE_BUCKET=subtitles

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# How long a login session lasts, in days
SESSION_DAYS=7

# Resend (https://resend.com/api-keys). Required in production.
# In development, if empty, emails are printed to the server console instead.
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "SHERE MUSIC <no-reply@yourdomain.com>"
RESEND_FROM_EMAIL=

# Public URL of the React app (used for email links and CORS).
# Comma-separate multiple origins; the first one is used in emails.
FRONTEND_URL=http://localhost:5173
# Optional extra CORS origins (comma-separated)
CORS_ORIGINS=

# Cookies. Defaults: secure + SameSite=None in production (frontend and API on different sites),
# SameSite=Lax in development. Set COOKIE_DOMAIN only if you need to share across subdomains.
COOKIE_SECURE=
COOKIE_SAMESITE=
COOKIE_DOMAIN=

# Hard upload ceilings in megabytes. Admin settings can lower (never raise) these.
MAX_AUDIO_MB=50
MAX_IMAGE_MB=5
MAX_VIDEO_MB=500

# Optional external lyrics provider (Admin → Settings → Lyrics can also store these).
# Values here take precedence and are never sent to the browser.
# The URL may contain {artist}, {title}, {album} and {duration} placeholders, e.g.
#   https://lyrics.example.com/api/get?artist={artist}&track={title}
LYRICS_API_URL=
LYRICS_API_KEY=

# Paystack (SHERE MUSIC Plus and artist submission fees). Server only — never
# put the secret key in the frontend. Use sk_test_… keys for test mode and
# sk_live_… keys for live mode. Set the webhook URL in the Paystack dashboard
# (Settings → API Keys & Webhooks) to: https://<your-api-domain>/api/payments/paystack/webhook
PAYSTACK_SECRET_KEY=
# Optional: only needed if you later switch to Paystack's inline popup. Checkout
# currently redirects to Paystack's hosted page, which needs no public key.
PAYSTACK_PUBLIC_KEY=

# Google and Facebook sign-in are configured in the Supabase dashboard
# (Authentication → Providers). No OAuth secrets are needed in this file.

# Number of reverse proxies in front of the API (1 on Render/Railway/Heroku/Nginx).
TRUST_PROXY=
